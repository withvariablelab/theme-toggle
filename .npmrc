# Supply-chain guard: never resolve a dependency version published less than
# 24 h ago (most malicious releases are pulled within the first hour). Requires
# pnpm >= 10.16.
#
# No exclude list on purpose: our own scopes (@variablelab/*, @rrlab/*) wait
# 24 h too. In .npmrc, `minimum-release-age-exclude[]` breaks whenever pnpm is
# launched through npm (`npx pnpm`, `npm exec`, `npm run`). npm re-exports the
# array as a single string, and pnpm 10.30.3 then exempts every package. To
# adopt a fresh own release right away, pass
# `--config.minimum-release-age=0` to that one `pnpm add`.
#
# This lives here instead of pnpm-workspace.yaml because @rrlab/cli (through
# @vlandoss/clibuddy 0.7.1) treats any repo with a pnpm-workspace.yaml as a
# monorepo, and `rr tsc` then fails ("Invalid workspace patterns") or, with
# `packages: ["."]`, silently skips this package. Once
# https://github.com/withvariablelab/dx/issues/249 ships, move it there with
# minimumReleaseAgeExclude, and delete this file.
minimum-release-age=1440
